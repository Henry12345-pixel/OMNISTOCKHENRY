<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.omnistock.omnistock.LoginController"
           prefWidth="1180" prefHeight="700"
           styleClass="page-root"
           stylesheets="@style.css"
           onMousePressed="#onRootMousePressed"
           onMouseDragged="#onRootMouseDragged">

    <!-- Close button (no OS title bar in transparent mode) -->
    <Button text="✕" styleClass="close-button" onAction="#onCloseClick"
            StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="20" right="20"/>
        </StackPane.margin>
    </Button>

    <!-- The card -->
    <HBox styleClass="login-card" maxWidth="880" maxHeight="520" prefWidth="880" prefHeight="520">

        <!-- Left branding panel -->
        <AnchorPane styleClass="brand-panel" prefWidth="340" prefHeight="520"
                    minWidth="340" maxWidth="340" HBox.hgrow="NEVER">

            <Circle styleClass="decor-circle" centerX="285" centerY="65" radius="55"/>
            <Circle styleClass="decor-circle" centerX="55" centerY="440" radius="42"/>

            <VBox spacing="0"
                  AnchorPane.topAnchor="36" AnchorPane.bottomAnchor="36"
                  AnchorPane.leftAnchor="32" AnchorPane.rightAnchor="28">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="logo-badge" prefWidth="34" prefHeight="34" maxWidth="34" maxHeight="34"/>
                    <Label text="OmniStock" styleClass="brand-title"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS" minHeight="24"/>

                <VBox spacing="8">
                    <Label text="One shelf, one screen," styleClass="hero-heading" wrapText="true"/>
                    <Label text="zero guesswork." styleClass="hero-heading" wrapText="true"/>
                    <Region minHeight="8"/>
                    <Label text="Track stock, ring up sales, and keep every product accounted for - built for small grocery teams."
                           styleClass="hero-subtext" wrapText="true" maxWidth="260"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" minHeight="24"/>
            </VBox>
        </AnchorPane>

        <!-- Right login form panel -->
        <VBox styleClass="form-panel" prefWidth="540" prefHeight="520"
              minWidth="540" maxWidth="540" HBox.hgrow="NEVER"
              alignment="CENTER" spacing="14">
            <padding>
                <Insets top="30" right="56" bottom="30" left="56"/>
            </padding>

            <fx:define>
                <ToggleGroup fx:id="roleToggleGroup"/>
            </fx:define>

            <HBox styleClass="role-toggle-container" alignment="CENTER" maxWidth="1.7976931348623157E308">
                <ToggleButton fx:id="adminToggle" text="Admin" styleClass="role-toggle"
                              toggleGroup="$roleToggleGroup" selected="true"
                              HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                              onAction="#onAdminSelected"/>
                <ToggleButton fx:id="staffToggle" text="Staff" styleClass="role-toggle"
                              toggleGroup="$roleToggleGroup"
                              HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                              onAction="#onStaffSelected"/>
            </HBox>

            <VBox spacing="2" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <Label fx:id="welcomeLabel" text="Welcome back, Admin" styleClass="welcome-heading"/>
                <Label fx:id="welcomeSubtext" text="Manage products, staff accounts, and store reports."
                       styleClass="welcome-subtext" wrapText="true"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField" styleClass="text-input"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="text-input"/>
            </VBox>

            <Region minHeight="6"/>

            <Button fx:id="loginButton" text="Log in to OmniStock" styleClass="login-button"
                    maxWidth="1.7976931348623157E308" onAction="#onLoginClick"/>

        </VBox>

    </HBox>

</StackPane>